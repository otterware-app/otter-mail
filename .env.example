# Copy to .env.local (gitignored) for local builds; CI reads the same names
# from the repository's Actions variables and secrets.

# Google OAuth "Desktop app" client in the primary Google Cloud project.
OTTER_MAIL_GOOGLE_CLIENT_ID=
OTTER_MAIL_GOOGLE_CLIENT_SECRET=

# Keep the previous client available to refresh existing mailbox sign-ins.
OTTER_MAIL_GOOGLE_LEGACY_CLIENT_ID=
OTTER_MAIL_GOOGLE_LEGACY_CLIENT_SECRET=

# Outlook in the desktop app: the Azure app registration's Application (client) ID. Its
# "Mobile and desktop applications" platform has the redirect URI http://localhost (any port)
# and "Allow public client flows" is on; there's no secret. Left empty, Outlook isn't offered.
OTTER_MAIL_MICROSOFT_CLIENT_ID=

# For local developer tests only; never shared with app users or given a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# The demo mailboxes `pnpm dev:demo` and `pnpm dev:demo:desktop` open on, a JSON list
# (packages/contracts/src/demo.ts; docs/development.md#demo-mailboxes). `--login` adds the
# Google sign-ins. Keep it in the main checkout's .env.local (T3 worktrees share it by symlink);
# never expose it through VITE_ variables or bundle it in the app.
OTTER_MAIL_DEMO_MAILBOXES='[{"provider":"gmail","email":"otterware.demo@gmail.com","password":"","refreshTokens":{}}]'
